<?xml version="1.0" encoding="utf-8"?>
<!-- Déclaration du widget : 3 × 2 cases, redimensionnable, jamais réveillé par une minuterie (updatePeriodMillis = 0) :
     c'est Selene qui le met à jour quand elle s'ouvre. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="80dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_selene"
    android:previewLayout="@layout/widget_selene"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
