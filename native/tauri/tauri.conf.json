{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selene",
  "version": "0.1.0",
  "identifier": "io.github.mariebonifacio.selene",
  "build": { "frontendDist": "../../dist/native" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Selene", "width": 1200, "height": 820, "minWidth": 360, "minHeight": 480, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["selene"] } } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "languages": ["French", "English"] } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
